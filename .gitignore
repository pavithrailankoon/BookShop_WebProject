# Ignore common operating system files
*.*~
*.swp
*.swo
*.DS_Store

# Ignore IDE specific files
.idea/*
.vscode/*

# Ignore build output
build/
dist/

# Ignore test data
tests/data/*

# Ignore temporary files
tmp/

# Ignore MySQL password file
.my.cnf

# Ignore generated reports
reports/*

# Ignore documentation build output
docs/build/*

# Ignore npm/yarn lock files (if not using package manager)
package-lock.json
yarn.lock

# Ignore environment specific files
.env
.env.local
.env.production
.env.development

# Ignore cache files
*.cache

# Ignore logs
logs/*